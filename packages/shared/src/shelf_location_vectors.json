{
  "_comment": "M0 shared vectors — single source of truth for shelf-code normalization. Tested by all three layers (SQL/Python/JS). ASCII-only by design: fullwidth and Arabic letters are REJECTED, Arabic-Indic digits are MAPPED to ASCII before validation. NBSP appears ONLY as \u00a0 escape (never a pasted byte).",
  "spec": {
    "strip_chars": "space, TAB (\\t), CR (\\r), LF (\\n), NBSP (U+00A0), hyphen-minus, underscore; all removed from the interior, stripped at the edges",
    "case_mapping": "ASCII a-z -> A-Z ONLY via explicit translate (no locale-dependent UPPER)",
    "digit_mapping": "Arabic-Indic digits -> 0-9 before validation",
    "empty_rule": "empty after normalization -> NULL (clear, not an error)",
    "final_pattern": "^[A-Z][1-9][0-9]?$ (one letter + 1..99, no leading zero)",
    "reserved_zones": "R=fridge, C=safe, F=backstore (interpretive only, not a grammar restriction)",
    "print_contract": "window.print() A4 via @page (receipt-screen pattern); no new Electron IPC; no barcode — large code text only"
  },
  "vectors": [
